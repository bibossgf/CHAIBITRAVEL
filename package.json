{
  "name": "chaibot",
  "version": "1.0.0",
  "description": "Private Discord AI Assistant for Project Management, Finance, Islam & Productivity",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --loader tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist node_modules package-lock.json"
  },
  "keywords": [
    "discord",
    "bot",
    "ai",
    "gemini",
    "project-management",
    "finance",
    "islam",
    "typescript"
  ],
  "author": "CHAIBOT Team",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.1",
    "@google/generative-ai": "^0.3.1",
    "sqlite3": "^5.1.6",
    "better-sqlite3": "^9.2.2",
    "dotenv": "^16.3.1",
    "node-cron": "^3.0.3",
    "axios": "^1.6.5",
    "nodemailer": "^6.9.7",
    "chart.js": "^4.4.1",
    "canvas": "^2.11.2",
    "date-fns": "^2.30.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.6",
    "@types/better-sqlite3": "^7.6.8",
    "tsx": "^4.7.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "prettier": "^3.11.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
